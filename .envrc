#!/usr/bin/env bash

watch_file flake.nix flake.lock .env .envrc.local
watch_dir nix

export IDR_PROJECT_NAME="idr"
export IDR_PROJECT_NAMESPACE="idr"

direnv_layout_dir() {
  local data_dir="${PRJ_DATA_DIR:-$PWD/.data}"
  local host_id=""
  if [[ -f /etc/machine-id ]]; then
    read -r host_id </etc/machine-id || true
  fi
  printf '%s\n' "$data_dir/${host_id:-$(hostname)}/direnv"
}

if [ -f .envrc.local ]; then
  # shellcheck disable=SC1091
  source ".envrc.local"
else
  use flake . || return $?
  # nix-direnv restores temp variables after the shell hook.
  if [[ -n "${IDR_TMPDIR:-}" ]]; then
    export TMPDIR="$IDR_TMPDIR"
    export TMP="$TMPDIR" TEMP="$TMPDIR"
  fi
fi
