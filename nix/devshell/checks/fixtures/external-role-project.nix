{
  top,
  project,
  machineId,
  prepared ? false,
}: {lib, ...}: {
  imports =
    (with top.self.modules.nixosTest; [base operator ssh-git])
    ++ lib.optional (!prepared) (lib.modules.importApply ./operator-project.nix {
      inherit project machineId;
      extraSetup = ''
        mkdir application-source
        tar --strip-components=1 -C application-source -xf ${project}/project.tar
        rm -rf application-source/nix/machine application-source/.data
        touch application-source/nix/.keep
        sed -i 's|file+file:///dev/null|git+ssh://git@github.com/myorg/team|' application-source/flake.nix
      '';
    });

  idr.test.sshGit.repositories = lib.mkForce [
    {
      source = "/home/operator/team";
      url = "git+ssh://git@github.com/myorg/team";
      writable = true;
    }
    {
      source = "/home/operator/application-source";
      url = "git+ssh://git@github.com/myorg/application";
      writable = true;
    }
  ];

  defaults = {pkgs, ...}:
    lib.mkIf prepared {
      # This archive contains only repositories and identities generated by the
      # initial check. Restore both working clones and the exact published refs;
      # reinitializing the server from its original sources would lose the grant.
      systemd.services.ssh-git-fixture = {
        path = [pkgs.gnutar];
        script = lib.mkForce ''
          umask 077
          tar --no-same-owner -C / -xf ${project}/external-role-project.tar
          chown -R operator:operator /home/operator
          # The project and application can pin different generations of team.
          # A fresh node must fetch those retained ancestors without relying on
          # the producer's fetcher cache or changing the current published ref.
          for repository in /var/lib/ssh-git/repositories/*; do
            git -C "$repository" config uploadpack.allowReachableSHA1InWant true
          done
          chown -R git:git /var/lib/ssh-git/repositories
          cat /home/operator/.ssh/id_ed25519.pub > /var/lib/ssh-git/authorized_keys
        '';
      };
    };
}
