@@ -635,6 +635,34 @@
     }
   
 
+  /* Static-only networks must not let client-supplied DUID/IAID values
+     release or decline another client's configured reservation. Validate
+     every IAADDR before any lease is pruned or marked as declined. */
+  if (msg_type == DHCP6RELEASE || msg_type == DHCP6DECLINE)
+    {
+      for (context_tmp = state->context; context_tmp; context_tmp = context_tmp->current)
+        if (!(context_tmp->flags & CONTEXT_STATIC))
+          break;
+
+      if (state->context && !context_tmp)
+        for (opt = state->packet_options; opt; opt = opt6_next(opt, state->end))
+          {
+            void *ia_option, *ia_end;
+
+            for (check_ia(state, opt, &ia_end, &ia_option);
+                 ia_option;
+                 ia_option = opt6_find(opt6_next(ia_option, ia_end), ia_end, OPTION6_IAADDR, 24))
+              {
+                struct in6_addr addr;
+
+                memcpy(&addr, opt6_ptr(ia_option, 0), IN6ADDRSZ);
+                context_tmp = address6_valid(state->context, &addr, tagif, 1);
+                if (!context_tmp || !config_implies(config, context_tmp, &addr))
+                  return 0;
+              }
+          }
+    }
+
   switch (msg_type)
     {
     default:
